    local function _show_objects(visible)
        for _, object in pairs(_toy_manager.attached_objects[-1]) do
            if object and doesObjectExist(object) then
                setObjectVisible(object, visible)
            end
        end
    end
    
    local function _parse_vector3(line, prefix, default)
        local pattern = "^" .. prefix .. ":%s*(-?%d*%.?%d+)%s+(-?%d*%.?%d+)%s+(-?%d*%.?%d+)$"
        local x, y, z = line:match(pattern)
        return x and {
            x = tonumber(x) or default.x,
            y = tonumber(y) or default.y,
            z = tonumber(z) or default.z
        } or nil
    end
    
    local function _is_valid_toy(toy)
        return toy ~= nil and toy.name ~= nil and toy.bone ~= nil and
            toy.offset ~= nil and toy.rotation ~= nil and toy.scale ~= nil
    end
    
    local function _reset_state()
        _toy_manager.pending_configs = {}
        _toy_manager.is_initial_scan_done = false
    end
    
    local function _parse_toys_from_input(text)
        if not text or text:match("^%s*$") then
            shared.notification:show("Input cannot be empty", shared.notification.types.ERROR)
            return false, {}
        end
    
        local toys = {}
        local toy = nil
        local line_num = 0
    
        for line in text:gmatch("[^\n]+") do
            line = line:trim()
            line_num = line_num + 1
    
            if line == "" then
                if _is_valid_toy(toy) then
                    table.insert(toys, toy)
                    toy = nil
                end
            elseif line:match("^Toy:") then
    
                if _is_valid_toy(toy) then
                    table.insert(toys, toy)
                end
    
                local name = line:match("^Toy:%s*(.+)$")
                toy = name and { name = name } or nil
    
                if not object_id_by_name[name] then
                    shared.notification:show(string.format("Toy '%s' has an invalid model name: '%s'", name or "Unknown"),
                        shared.notification.types.ERROR)
                    return false, {}
                end
    
            elseif toy then
                if line:match("^Bone:") then
                    local name = line:match("^Bone:%s*(.+)$")
    
                    if not bone_by_name[name] then
                        shared.notification:show(string.format("Toy '%s' has an invalid bone: '%s'", toy.name, name),
                            shared.notification.types.ERROR)
                        return false, {}
                    end
    
                    toy.bone = name
                elseif line:match("^Offset") then
                    toy.offset = _parse_vector3(line, "Offset", DEFAULT_OFFSET)
                elseif line:match("^Rotation") then
                    toy.rotation = _parse_vector3(line, "Rotation", DEFAULT_ROTATION)
                elseif line:match("^Scale") then
                    toy.scale = _parse_vector3(line, "Scale", DEFAULT_SCALE)
                end
            end
        end
    
        if _is_valid_toy(toy) then
            table.insert(toys, toy)
        end
    
        if #toys > 0 then
            shared.notification:show("Toys loaded successfully", shared.notification.types.OK)
            return true, toys
        end
    
        shared.notification:show("No valid toys found", shared.notification.types.ERROR)
        return false, {}
    end
    
    local function _attach_toy(slot, model, bone, offset, rotation, scale)
        local bs = raknetNewBitStream()
    
        raknetBitStreamWriteInt16(bs, select(2, sampGetPlayerIdByCharHandle(PLAYER_PED)))
        raknetBitStreamWriteInt32(bs, slot)
        raknetBitStreamWriteBool(bs, true)
        raknetBitStreamWriteInt32(bs, model)
        raknetBitStreamWriteInt32(bs, bone)
        raknetBitStreamWriteFloat(bs, offset.x)
        raknetBitStreamWriteFloat(bs, offset.y)
        raknetBitStreamWriteFloat(bs, offset.z)
        raknetBitStreamWriteFloat(bs, rotation.x)
        raknetBitStreamWriteFloat(bs, rotation.y)
        raknetBitStreamWriteFloat(bs, rotation.z)
        raknetBitStreamWriteFloat(bs, scale.x)
        raknetBitStreamWriteFloat(bs, scale.y)
        raknetBitStreamWriteFloat(bs, scale.z)
        raknetBitStreamWriteInt32(bs, 0)
        raknetBitStreamWriteInt32(bs, 0)
    
        raknetEmulRpcReceiveBitStream(113, bs)
        raknetDeleteBitStream(bs)
    end
    
    local function _detach_toy(slot)
        local bs = raknetNewBitStream()
    
        raknetBitStreamWriteInt16(bs, select(2, sampGetPlayerIdByCharHandle(PLAYER_PED)))
        raknetBitStreamWriteInt32(bs, slot)
        raknetBitStreamWriteBool(bs, false)
    
        raknetEmulRpcReceiveBitStream(113, bs)
        raknetDeleteBitStream(bs)
    end
    
    local function _configure_toys(toys)
        if not toys or #toys == 0 then
            shared.notification:show("No toys given", shared.notification.types.ERROR)
            return false
        end
    
        _reset_state()
    
        for _, toy in ipairs(toys) do
            toy.offset = toy.offset or DEFAULT_OFFSET
            toy.rotation = toy.rotation or DEFAULT_ROTATION
            toy.scale = toy.scale or DEFAULT_SCALE
    
            table.insert(_toy_manager.pending_configs, toy)
        end
    
        shared.notification:show(string.format("Loaded %d toy(s)", #toys), shared.notification.types.OK)
        samp_send_hidden_command("toys")
        return true
    end
    
    local function _load_from_input(text)
        local success, toys = _parse_toys_from_input(text)
    
        if success then
            return _configure_toys(toys)
        end
    
        return false
    end
    
    local function _export_attached_objects_for_player(player_id)
        local player_objects = _toy_manager.attached_objects[player_id]
        if not player_objects or #player_objects == 0 then
            shared.notification:show("No attached objects for selected player", shared.notification.types.ERROR)
            return false, ""
        end
    
        local result = {}
        local count = 0
    
        for i, obj in pairs(player_objects) do
            local bone = BONES[obj.bone]
            if obj.modelId ~= CELLPHONE_RECIPIENT_OBJECT and bone then
                local name = OBJECT_NAMES[obj.modelId] or "Unknown"
                local offset = obj.offset or DEFAULT_OFFSET
                local rotation = obj.rotation or DEFAULT_ROTATION
                local scale = obj.scale or DEFAULT_SCALE
    
                table.insert(result, string.format(
                    "Toy: %s\nBone: %s\nOffset: %.2f %.2f %.2f\nRotation: %.2f %.2f %.2f\nScale: %.2f %.2f %.2f",
                    name, bone.name, offset.x, offset.y, offset.z,
                    rotation.x, rotation.y, rotation.z, scale.x, scale.y, scale.z))
    
                count = count + 1
            end
        end
    
        if count == 0 then
            shared.notification:show("No valid attached objects for selected player", shared.notification.types.ERROR)
            return false, ""
        end
    
        return true, table.concat(result, "\n\n")
    end
    
    local function _parse_toys_from_dialog(text)
        local dialog_toys = {}
        local listitem = 0
    
        for item, bone in text:gmatch("%(%d+%) (%w+) %(Bone: (.-)%)") do
            if item ~= "None" then
                dialog_toys[listitem] = {
                    name = item,
                    bone = bone
                }
            end
    
            listitem = listitem + 1
        end
    
        if #dialog_toys == 0 then
            return nil
        end
    
        return dialog_toys
    end
    
    local function _get_next_item_in_queue()
        local index, config = next(_toy_manager.pending_configs)
        return index, config
    end
    
    local function _register_handlers()
    
        shared.event_handler:register("SHOW_DIALOG",
            function(id, style, title, button1, button2, text)
                if id == 93 and title == "Toy Menu" and not is_command_self_sent("toys") then
                    return { id }
                end
    
                return false
            end,
            function(id)
                sampSendDialogResponse(id, 1, 1, "")
                return false
            end
        )
    
        shared.event_handler:register("SHOW_DIALOG",
            function(id, style, title, button1, button2, text)
                if id == 102 and title == "Select a Toy" and not is_command_self_sent("toys") then
                    local parsed_toys = _parse_toys_from_dialog(text)
                    return { id, parsed_toys }
                end
    
                return false
            end,
            function(id, parsed_toys)
                if not parsed_toys then
                    shared.notification:show("No toys found in dialog", shared.notification.types.ERROR)
                    return false
                end
    
                if not _toy_manager.is_initial_scan_done then
                    _toy_manager.is_initial_scan_done = true
    
                    local matched_configs = {}
                    local match_count = 0
    
                    local used_configs = {}
    
                    for listitem, dialog_toy in pairs(parsed_toys) do
    
                        for index, config in ipairs(_toy_manager.pending_configs) do
                            if not used_configs[index] and config.name == dialog_toy.name then
                                match_count = match_count + 1
                                matched_configs[listitem] = config
                                matched_configs[listitem].requires_bone_change = config.bone ~= dialog_toy.bone
                                used_configs[index] = true
    
                                break
                            end
                        end
                    end
    
                    local unmatched_count = #_toy_manager.pending_configs - match_count
                    if unmatched_count > 0 then
                        shared.notification:show(
                            string.format("Warning: %d toy(s) couldn't be matched to dialog items", unmatched_count),
                            shared.notification.types.INFO
                        )
                    end
    
                    _toy_manager.pending_configs = matched_configs
                end
    
                local next_index, next_config = _get_next_item_in_queue()
                if next_index and next_config then
                    sampSendDialogResponse(id, 1, next_index, "")
                end
    
                return false
            end
        )
    
        shared.event_handler:register("SHOW_DIALOG",
            function(id, style, title, button1, button2, text)
                if id == 103 and title == "Toy Menu: Edit" and not is_command_self_sent("toys") then
                    return { id }
                end
    
                return false
            end,
            function(id)
                local next_index, next_config = _get_next_item_in_queue()
                if not next_index or not next_config then
                    sampSendDialogResponse(id, 0, 0, "")
                    return false
                end
    
                if next_config.requires_bone_change then
                    sampSendDialogResponse(id, 1, 0, "")
                else
                    if not _toy_manager.is_initialized then
                        sampSendDialogResponse(id, 1, 1, "")
                    end
    
                    local cfg = next_config
                    if cfg then
                        sampSendEditAttachedObject(1, next_index, object_id_by_name[next_config.name], bone_by_name[next_config.bone].id,
                            cfg.offset.x, cfg.offset.y, cfg.offset.z,
                            cfg.rotation.x, cfg.rotation.y, cfg.rotation.z,
                            cfg.scale.x, cfg.scale.y, cfg.scale.z)
                    end
    
                    if _toy_manager.is_initialized then
                        _toy_manager.pending_configs[next_index] = nil
                        sampSendDialogResponse(id, 0, 0, "")
                    end
                end
                return false
            end
        )
    
        shared.event_handler:register("SHOW_DIALOG",
            function(id, style, title, button1, button2, text)
                return id == 104 and title == "Select a Bone" and not is_command_self_sent("toys") and { id } or false
            end,
            function(id)
                local next_index, next_config = _get_next_item_in_queue()
    
                if not next_index or not next_config then
                    sampSendDialogResponse(id, 0, 0, "")
                    return false
                end
    
                if next_config.requires_bone_change and next_config.bone then
                    sampSendDialogResponse(id, 1, bone_by_name[next_config.bone].id, "")
                    next_config.requires_bone_change = false
                else
                    sampSendDialogResponse(id, 0, 0, "")
                end
    
                return false
            end
        )
    
        shared.event_handler:register("EDIT_ATTACHED_OBJECT",
            function(index)
                if not _toy_manager.is_initialized and _toy_manager.pending_configs[index] then
                    return { index }
                end
    
                return false
            end,
            function(index)
                _toy_manager.is_initialized = true
                _toy_manager.pending_configs[index] = nil
    
                if #_toy_manager.pending_configs > 0 then
                    samp_send_hidden_command("toys")
                end
    
                return false
            end
        )
    
        shared.event_handler:register(
            "PLAYER_JOIN",
            function(player_id, color, is_npc, nick)
                return select(2, sampGetPlayerIdByCharHandle(PLAYER_PED)) == player_id
            end,
            function()
                _toy_manager.is_initialized = false
            end
        )
    
        shared.event_handler:register("SET_PLAYER_ATTACHED_OBJECT",
            function(player_id, index, create, object)
                return { player_id, index, create, object }
            end,
            function(player_id, index, create, object)
                local my_id = select(2, sampGetPlayerIdByCharHandle(PLAYER_PED))
    
                if player_id == my_id then
                    player_id = -1
                end
    
                if not _toy_manager.attached_objects[player_id] then
                    _toy_manager.attached_objects[player_id] = {}
                end
    
                _toy_manager.attached_objects[player_id][index] = create and object or nil
            end
        )
    
        shared.event_handler:register(
            "PLAYER_STREAM_OUT",
            function(player_id)
                return { player_id }
            end,
            function(player_id)
                _toy_manager.attached_objects[player_id] = nil
            end
        )
    
        shared.event_handler:register("PED_TICK_ON_FOOT",
            function(x, y, z)
                if #_toy_manager.attached_objects[-1] > 0 then
                    return { x, y, z }
                end
    
                return false
            end,
            function()
                local is_scoping = is_aiming(true)
    
                if is_scoping and not _toy_manager.are_hidden then
                    _show_objects(false)
                    _toy_manager.are_hidden = true
                elseif not is_scoping and _toy_manager.are_hidden then
                    _show_objects(true)
                    _toy_manager.are_hidden = false
                end
            end
        )
    end
    
