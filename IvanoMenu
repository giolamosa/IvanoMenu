    local CELLPHONE_RECIPIENT_OBJECT = 330
    
    local DEFAULT_OFFSET = { x = 0, y = 0, z = 0 }
    local DEFAULT_ROTATION = { x = 0, y = 0, z = 0 }
    local DEFAULT_SCALE = { x = 1, y = 1, z = 1 }
    
    local bone_by_name = {}
    for _, bone in ipairs(BONES) do
        bone_by_name[bone.name] = bone
    end
    
    local object_id_by_name = {}
    for id, name in pairs(OBJECT_NAMES) do
        object_id_by_name[name] = id
    end
    
    local _toy_manager = {
        attached_objects = { [-1] = {} },
        is_initialized = false,
        is_initial_scan_done = false,
        pending_configs = {},
    
        are_hidden = false,
        visualized_objects = {},
    }
    
