    function ToyManager:render_ui_settings()
        local style = imgui.GetStyle()
        local inputtext_height = imgui.GetContentRegionAvail().y
            - style.WindowPadding.y * 2
            - imgui.GetFrameHeight() * 2
            - style.ItemSpacing.y * 2.5
    
        imgui.DrawChild("Toy Manager", function()
            imgui.InputTextMultiline("##toy_config", _toy_config, ffi.sizeof(_toy_config), imgui.ImVec2(-1, inputtext_height))
    
            if imgui.AnimButton("Apply") then
                _load_from_input(ffi.string(_toy_config))
            end
    
            imgui.SameLine()
    
            if #_toy_manager.visualized_objects == 0 then
                if imgui.AnimButton("Visualize") then
    
                    for slot, object in pairs(_toy_manager.attached_objects[-1]) do
                        _detach_toy(slot)
                    end
    
