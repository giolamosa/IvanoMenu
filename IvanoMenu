local current_script_version = 16 -- INCREASE THIS NUMBER BEFORE UPLOADING A NEW UPDATE TO GITHUB
local script_url = "https://raw.githubusercontent.com/giolamosa/IvanoMenu/refs/heads/main/IvanoMenu"
local version_url = "https://raw.githubusercontent.com/giolamosa/IvanoMenu/refs/heads/main/version.txt"

-- We added 'is_manual' so it knows if a player typed the command or if it's the automatic startup check
local function check_for_updates(is_manual)
    local AsyncHttpRequest = require("src.utils.AsyncHttpRequest")
    
    if is_manual then
        sampAddChatMessage("{BE60F7}[Ivano Menu] {FFFFFF}Checking for updates...", -1)
    end
    
    AsyncHttpRequest:new("GET", version_url, nil, 10)
        :then_(function(response)
            if not response or not response.text then 
                if is_manual then
                    sampAddChatMessage("{BE60F7}[Ivano Menu] {FFFFFF}Failed to connect to GitHub.", -1)
                end
                return 
            end
            
            local online_version = tonumber(response.text:match("%d+")) 
            
            if online_version and online_version > current_script_version then
                sampAddChatMessage("{BE60F7}[Ivano Menu] {FFFFFF}New update found! Downloading...", -1)
                
                AsyncHttpRequest:new("GET", script_url, nil, 15)
                    :then_(function(script_res)
                        if script_res and script_res.text then
                            local f = io.open(thisScript().path, 'w')
                            if f then
                                f:write(script_res.text)
                                f:close()
                                sampAddChatMessage("{BE60F7}[Ivano Menu] {FFFFFF}Update complete! Reloading script...", -1)
                                thisScript():reload()
                            end
                        end
                    end)
            else
                if is_manual then
                    sampAddChatMessage("{BE60F7}[Ivano Menu] {FFFFFF}You are already using the latest version!", -1)
                end
            end
        end)
end
