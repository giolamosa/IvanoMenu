        register_commands()
        shared.event_handler:process("onScriptInit")
        local timestamp = os.date("%m/%d/%Y %I:%M %p", __luapack_timestamp)
        msg(string.format("Packed on: {BE60F7}%s{FFFFFF}. Use {BE60F7}/avmenu cmds{FFFFFF}.", timestamp))
        
        while true do
            process_player_tick()
            wait(0)
        end
    end

end

return require('src.main')
